# igorstar admin portal — copy to .env and fill in.
# .env is gitignored; never commit real tokens.

# Space (same as the main site)
CONTENTFUL_SPACE_ID=oibc438e8tog

# Delivery API token — read-only. Used for all read endpoints.
CONTENTFUL_ACCESS_TOKEN=

# Management API token (Personal Access Token) — required for WRITES.
# Must have entries + assets read/write on the target environment.
# The delivery token above is NOT sufficient for writes.
CONTENTFUL_PAT=

# Target environment. Allow-list: master, develop (enforced in lib/credentials.js).
# Default matches the site: the delivery client reads master.
CONTENTFUL_ENV=master
