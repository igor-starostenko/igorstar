# igorstar admin portal — copy to .env and fill in what's missing.
# .env is gitignored; never commit real tokens.
#
# INHERITANCE: next.config.js loads the root ../.env as a fallback layer for
# CONTENTFUL_* keys, so you usually only need to add the PAT here. Precedence:
#   real environment variables  >  admin/.env  >  root .env
# Leave a value empty to inherit it from the root .env; set a value to override.

# Space (inherited from the root .env — same as the main site).
# Only set here if you ever need to point the portal at a different space.
CONTENTFUL_SPACE_ID=

# Delivery API token — read-only. Used for all read endpoints.
# Inherited from the root .env (the same token the site uses). Only set here
# to override, e.g. for a read-only token scoped tighter than the site's.
CONTENTFUL_ACCESS_TOKEN=

# Management API token (Personal Access Token) — required for WRITES.
# Not in the root .env, so this is the one you must fill in to save changes.
# Must have entries + assets read/write on the target environment.
# The delivery token above is NOT sufficient for writes (you'll get a 401).
CONTENTFUL_PAT=

# Target environment. Allow-list: master, develop (enforced in src/lib/contentful.js).
# Not in the root .env, so this always comes from here (or defaults to master).
CONTENTFUL_ENV=master
