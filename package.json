{
  "name": "igorstar",
  "license": "MIT",
  "type": "module",
  "author": "Igor Starostenko <contact@igorstar.com>",
  "scripts": {
    "analyze": "source-map-explorer .next/static/**/*.js",
    "dev": "next dev",
    "start": "serve out",
    "format": "prettier --config ./.prettierrc --write src/**/*.{js,jsx}",
    "lint": "eslint 'src/**/*.{js,jsx}'",
    "build:analyze": "npm run build && npm run analyze",
    "build:dir": "mkdirp ./public/icons/ && mkdirp ./public/images/",
    "build:favicons": "node scripts/favicons.cjs",
    "build:sitemap": "next-sitemap",
    "build:images": "npm run contentful:assets",
    "build": "npm run build:dir && npm run build:favicons && next build && npm run build:sitemap && npm run build:images",
    "contentful:assets": "node scripts/contentful-assets.js",
    "contentful:backup": "node scripts/contentful-backup.js",
    "contentful:export": "contentful space export --space-id $CONTENTFUL_SPACE_ID",
    "test:lighthouse": "vitest run src/test/lighthouse.test.mjs",
    "test:helpers": "vitest run src/helpers/*.test.js",
    "test:components": "vitest run src/components/**/*.test.jsx",
    "test": "vitest --exclude src/test/lighthouse.test.mjs --run"
  },
  "greenkeeper": {
    "ignore": [
      "core-js"
    ]
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@contentful/rich-text-react-renderer": "^16.2.1",
    "babel-plugin-styled-components": "^2.0.7",
    "contentful": "^11.12.2",
    "dotenv": "^17.4.2",
    "fast-xml-parser": "^5.9.0",
    "framer-motion": "^12.40.0",
    "next": "^16.2.11",
    "prop-types": "^15.6.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-photo-album": "^3.6.0",
    "react-syntax-highlighter": "^16.1.1",
    "serve": "^14.2.6",
    "styled-components": "^6.4.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-modules-commonjs": "^7.28.6",
    "@babel/preset-react": "^7.28.5",
    "@babel/register": "^7.28.6",
    "@next/bundle-analyzer": "^16.2.6",
    "@node-loader/babel": "^2.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/ui": "^4.1.7",
    "chrome-launcher": "^0.14.2",
    "contentful-cli": "^4.0.1",
    "contentful-management": "^12.5.0",
    "contentful-migration": "^5.0.0",
    "core-js": "^3.19.1",
    "directory-named-webpack-plugin": "^4.0.0",
    "eslint": "^9.7.0",
    "eslint-config-next": "^16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "esm": "^3.2.25",
    "favicons": "^7.2.0",
    "jsdom": "^29.1.1",
    "lighthouse": "^13.3.0",
    "mkdirp": "^1.0.4",
    "next-sitemap": "^4.2.3",
    "node-gyp": "^12.3.0",
    "prettier": "^3.8.3",
    "source-map-explorer": "^2.5.3",
    "vitest": "^4.1.7",
    "webpack": "^5.107.2"
  },
  "packageManager": "yarn@4.15.0"
}
