{
  "extends": [
    "next/core-web-vitals",
    "prettier"
  ],
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/prop-types": "off"
  },
  "overrides": [
    {
      "files": ["src/**/*.test.{js,jsx}"],
      "rules": {
        "@next/next/no-img-element": "off",
        "react/display-name": "off"
      }
    }
  ],
  "ignorePatterns": [
    "node_modules/",
    ".next/",
    "out/",
    "build/",
    "public/",
    "coverage/"
  ]
}
